{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track appVersion in Chart.yaml via the # renovate datasource=... depName=... annotation",
      "managerFilePatterns": ["/(^|/)Chart\\.yaml$/"],
      "matchStrings": [
        "#\\s*renovate:?\\s*datasource=(?<datasource>.*?)\\s*depName=(?<depName>.*?)\\s*\\n\\s*appVersion:\\s*\"?(?<currentValue>[\\w.-]+)\"?"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Bump the chart version for any dependency update inside a chart directory (appVersion, values.yaml images, chart dependencies)",
      "matchFileNames": ["charts/**"],
      "bumpVersions": [
        {
          "filePatterns": ["{{packageFileDir}}/Chart.yaml"],
          "matchStrings": ["(?m)^version:\\s+(?<version>\\S+)"],
          "bumpType": "patch"
        }
      ]
    }
  ]
}
